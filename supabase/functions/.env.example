# Local secrets for `supabase functions serve --env-file supabase/functions/.env`.
# Copy this file to `.env` (gitignored) and fill in real values.
# Get the actual values from the project owner via a password manager (1Password),
# never Slack/email. NEVER commit the real `.env`.
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are auto-injected by the Supabase
# CLI from the running local stack — only set keys for external services here.

# Claude API key (Anthropic Console)
ANTHROPIC_API_KEY=

# OpenAI key — used only for embeddings
OPENAI_API_KEY=

# Airtable personal access token — used for write-backs
AIRTABLE_PAT=

# Shared secret for the x-audit-secret header.
# IMPORTANT: production uses its own PROD secret, NOT the prototype's. Using
# the wrong one makes every audit fail with 401. Get the value from Vault.
AUDIT_SHARED_SECRET=

# Optional: offload only >50-page PDFs from sync-control-evidence to Make.com.
# Leave both blank to keep the existing in-Supabase extractor path.
MAKE_LARGE_PDF_WEBHOOK_URL=
MAKE_WEBHOOK_SECRET=

# Webhook ACK timeout.
MAKE_WEBHOOK_TIMEOUT_MS=15000
MAKE_CALLBACK_LEASE_MS=300000
# Healthy large reports can take 40+ minutes. After two hours without a callback,
# the scheduled watchman closes the Make job and a fresh Run V3 may retry it.
MAKE_EXTERNAL_STALE_MS=7200000
